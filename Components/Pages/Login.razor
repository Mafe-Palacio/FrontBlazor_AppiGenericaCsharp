@*
    Login.razor - Pagina de inicio de sesion.

    CONCEPTOS BLAZOR:
    - @page "/login"          -> Define la URL de esta pagina
    - @layout EmptyLayout     -> Usa un layout vacio (sin sidebar) porque el login no necesita menu
    - @inject AuthService     -> Inyecta el servicio de autenticacion (Dependency Injection)
    - @inject NavigationManager -> Para redirigir a otra pagina despues del login
    - @rendermode InteractiveServer -> Necesario para que @onclick y @bind funcionen (SignalR)
    - @bind="email"           -> Two-way binding: sincroniza la variable con el input
    - @onclick="DoLogin"      -> Al hacer clic, ejecuta el metodo DoLogin()

    FLUJO:
    1. Usuario escribe email y contrasena
    2. Clic en "Iniciar sesion" -> llama DoLogin()
    3. DoLogin() llama auth.Login() que verifica con BCrypt en la API
    4. Si OK -> redirige a "/" (inicio)
    5. Si debe cambiar contrasena -> redirige a "/cambiar-contrasena"
    6. Si falla -> muestra error en alerta roja
*@

@page "/login"
@layout FrontBlazor_AppiGenericaCsharp.Components.Layout.EmptyLayout
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService auth
@inject NavigationManager nav
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-microscope" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
            <img src="nuevo_logo.png" alt="Logo" style="width:90px; margin-bottom: 0.5rem;" />
            <h4>Gestión de Investigación</h4>
            <p class="small mb-0 opacity-75">CRUD Investigación</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert-custom alert-err mb-3">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@error</span>
                    <button class="alert-close" @onclick='() => error = ""'>&times;</button>
                </div>
            }

            <div class="mb-3">
                <label class="form-label small fw-bold text-muted">Correo electrónico</label>
                <input type="email" class="login-input" @bind="email" placeholder="nombre@itm.edu.co" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold text-muted">Contraseña</label>
                <input type="password" class="login-input" @bind="contrasena" 
                       @onkeypress="OnKeyPress" placeholder="••••••••" />
            </div>

            <button class="btn-login" @onclick="DoLogin" disabled="@cargando">
                @if (cargando) {
                    <span class="spinner me-2" style="width:16px; height:16px; border-width:2px; display:inline-block; vertical-align:middle;"></span>
                    <span>Cargando...</span>
                } else {
                    <span>Iniciar sesión</span>
                }
            </button>

            <div class="text-center mt-4">
                <a href="/crear-usuario" class="login-link">
                    Crear cuenta
                </a>
                <a href="/recuperar-contrasena" class="small text-muted text-decoration-none hover-danger">
                    ¿Olvidó su contraseña?
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    string email = "", contrasena = "", error = "";
    bool cargando;

    async Task DoLogin()
    {
        error = "";
        cargando = true;
        var (ok, msg) = await auth.Login(email, contrasena);
        cargando = false;
        if (ok)
        {
            // Si recupero contrasena, forzar cambio
            if (auth.DebeCambiarContrasena || auth.DebeForcarCambio(email))
            {
                auth.DebeCambiarContrasena = true;
                nav.NavigateTo("/cambiar-contrasena", forceLoad: false);
            }
            else
                nav.NavigateTo("/", forceLoad: false);
        }
        else error = msg;
    }

    async Task OnKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await DoLogin();
    }
}
