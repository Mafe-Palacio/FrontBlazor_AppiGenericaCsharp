@page "/dashboard"
@inject FrontBlazor_AppiGenericaCsharp.Services.SpService SpService
@inject IJSRuntime JS
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>Dashboard</PageTitle>

<style>
    .db-wrap    { padding:1.75rem 2rem; max-width:1400px; }
    .db-header  { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; }
    .db-title   { display:flex; align-items:center; gap:.6rem; font-size:1.4rem; font-weight:800; color:var(--text); }
    .db-title i { color:var(--green-deeper); }
    .db-divider { border:none; border-top:1.5px solid var(--border); margin:1.5rem 0; }

    /* Cards */
    .db-card { border:none; border-radius:16px; padding:20px 18px 16px;
               position:relative; overflow:hidden; color:#fff;
               transition:transform .2s,box-shadow .2s; min-height:115px; }
    .db-card:hover { transform:translateY(-4px); box-shadow:0 12px 32px rgba(0,0,0,.18); }
    .db-card-bg  { position:absolute; right:-10px; top:50%; transform:translateY(-50%);
                   font-size:5.5rem; opacity:.13; pointer-events:none; }
    .db-card-val { display:block; font-size:2.4rem; font-weight:900; line-height:1; letter-spacing:-.02em; }
    .db-card-lbl { display:block; font-size:.7rem; font-weight:600; text-transform:uppercase;
                   letter-spacing:.05em; opacity:.85; margin-top:4px; line-height:1.3; }
    .db-card-bar  { height:4px; background:rgba(255,255,255,.28); border-radius:99px;
                    overflow:hidden; margin-top:12px; }
    .db-card-fill { height:100%; background:rgba(255,255,255,.8); border-radius:99px; }
    .db-card-ico  { position:absolute; top:12px; right:12px; font-size:1.1rem; opacity:.55; }

    .db-c1 { background:linear-gradient(135deg,#2d6a1f,#4a8f34); box-shadow:0 4px 20px rgba(45,106,31,.35); }
    .db-c2 { background:linear-gradient(135deg,#3d7a2a,#5fa042); box-shadow:0 4px 20px rgba(61,122,42,.30); }
    .db-c3 { background:linear-gradient(135deg,#6fa057,#8dba74); box-shadow:0 4px 20px rgba(111,160,87,.30); }
    .db-c4 { background:linear-gradient(135deg,#8dba74,#a2cb8b); box-shadow:0 4px 20px rgba(141,186,116,.30); }
    .db-c5 { background:linear-gradient(135deg,#4e8c3a,#6fad55); box-shadow:0 4px 20px rgba(78,140,58,.28); }

    /* Paneles gráfica */
    .db-chart-panel { background:#fff; border:1px solid var(--border);
                      border-radius:14px; padding:20px 22px; box-shadow:var(--shadow); }
    .db-chart-ttl   { font-size:.95rem; font-weight:700; color:var(--text);
                      display:flex; align-items:center; gap:.45rem; margin:0 0 2px; }
    .db-chart-ttl i { color:var(--green-deeper); }
    .db-chart-sub   { font-size:.75rem; color:var(--text-muted); margin:0 0 14px; }
    .db-canvas-wrap { position:relative; height:260px; }

    /* Tabla */
    .db-table th { background:var(--green-faint); color:var(--green-deeper);
                   font-size:.78rem; text-transform:uppercase; letter-spacing:.04em; }
    .db-table td { font-size:.875rem; vertical-align:middle; }
    .db-badge    { display:inline-block; padding:2px 10px; border-radius:99px;
                   font-size:.75rem; font-weight:600; }
    .db-num      { font-size:1.05rem; font-weight:700; color:var(--text); }

    /* Botón volver */
    .btn-back { display:flex; align-items:center; gap:.4rem; background:#fff;
                color:var(--text-muted); border:1px solid var(--border);
                padding:.45rem 1rem; border-radius:var(--radius);
                font-weight:600; font-size:.875rem; transition:all .18s; cursor:pointer; }
    .btn-back:hover { background:var(--green-faint); color:var(--green-deeper); border-color:var(--green-deeper); }

    .chart-spinner { display:flex; align-items:center; justify-content:center;
                     height:260px; color:var(--text-muted); gap:.5rem; font-size:.875rem; }
</style>

<div class="db-wrap">

    <div class="db-header">
        <div class="db-title"><i class="bi bi-speedometer2"></i> Dashboard</div>
        <button class="btn-back" @onclick='() => Nav.NavigateTo("/")'>
            <i class="bi bi-arrow-left"></i> Volver
        </button>
    </div>

    @* ════ CARDS ════ *@
    @if (cargandoCards)
    {
        <div class="d-flex align-items-center gap-2 text-muted py-3">
            <div class="spinner-border spinner-border-sm" style="color:var(--green-deeper)"></div>
            Cargando métricas...
        </div>
    }
    else if (!string.IsNullOrEmpty(errorCards))
    {
        <div class="alert alert-warning">@errorCards</div>
    }
    else
    {
        <div class="row g-3 mb-2">
            <div class="col-12 col-sm-6 col-xl">
                <div class="db-card db-c1">
                    <span class="db-card-bg"><i class="bi bi-people"></i></span>
                    <span class="db-card-ico"><i class="bi bi-people-fill"></i></span>
                    <span class="db-card-val">@cTotalGrupos</span>
                    <span class="db-card-lbl">Total Grupos de Investigación</span>
                    <div class="db-card-bar"><div class="db-card-fill" style="width:@Pct(cTotalGrupos,20)%"></div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl">
                <div class="db-card db-c2">
                    <span class="db-card-bg"><i class="bi bi-mortarboard"></i></span>
                    <span class="db-card-ico"><i class="bi bi-mortarboard-fill"></i></span>
                    <span class="db-card-val">@cTotalSemilleros</span>
                    <span class="db-card-lbl">Total Semilleros</span>
                    <div class="db-card-bar"><div class="db-card-fill" style="width:@Pct(cTotalSemilleros,30)%"></div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl">
                <div class="db-card db-c3">
                    <span class="db-card-bg"><i class="bi bi-briefcase"></i></span>
                    <span class="db-card-ico"><i class="bi bi-briefcase-fill"></i></span>
                    <span class="db-card-val">@cAreasApVinc</span>
                    <span class="db-card-lbl">Áreas de Aplicación Vinculadas</span>
                    <div class="db-card-bar"><div class="db-card-fill" style="width:@Pct(cAreasApVinc,25)%"></div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl">
                <div class="db-card db-c4">
                    <span class="db-card-bg"><i class="bi bi-book"></i></span>
                    <span class="db-card-ico"><i class="bi bi-book-fill"></i></span>
                    <span class="db-card-val">@cAreasCoVinc</span>
                    <span class="db-card-lbl">Áreas de Conocimiento Vinculadas</span>
                    <div class="db-card-bar"><div class="db-card-fill" style="width:@Pct(cAreasCoVinc,50)%"></div></div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-xl">
                <div class="db-card db-c5">
                    <span class="db-card-bg"><i class="bi bi-globe2"></i></span>
                    <span class="db-card-ico"><i class="bi bi-globe-americas"></i></span>
                    <span class="db-card-val">@cOdsVinc</span>
                    <span class="db-card-lbl">ODS Vinculados</span>
                    <div class="db-card-bar"><div class="db-card-fill" style="width:@Pct(cOdsVinc,17)%"></div></div>
                </div>
            </div>
        </div>
    }

    <hr class="db-divider" />

    @* ════ FILA 1 GRÁFICAS ════ *@
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="db-chart-panel">
                <p class="db-chart-ttl"><i class="bi bi-bar-chart-fill"></i> Grupos por Categoría</p>
                <p class="db-chart-sub">Cantidad de grupos en cada categoría (A, B, C…)</p>
                @if (cargandoGraficas)
                { <div class="chart-spinner"><div class="spinner-border spinner-border-sm" style="color:var(--green-deeper)"></div> Cargando...</div> }
                else
                { <div class="db-canvas-wrap"><canvas id="chartGruposCategoria"></canvas></div> }
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="db-chart-panel">
                <p class="db-chart-ttl"><i class="bi bi-pie-chart-fill"></i> Áreas de Conocimiento más Investigadas</p>
                <p class="db-chart-sub">Distribución por área de conocimiento</p>
                @if (cargandoGraficas)
                { <div class="chart-spinner"><div class="spinner-border spinner-border-sm" style="color:var(--green-deeper)"></div> Cargando...</div> }
                else
                { <div class="db-canvas-wrap"><canvas id="chartAreasCon"></canvas></div> }
            </div>
        </div>
    </div>

    @* ════ FILA 2 GRÁFICAS ════ *@
    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="db-chart-panel">
                <p class="db-chart-ttl"><i class="bi bi-graph-up"></i> Evolución de Fundaciones</p>
                <p class="db-chart-sub">Grupos y semilleros creados por año</p>
                @if (cargandoGraficas)
                { <div class="chart-spinner"><div class="spinner-border spinner-border-sm" style="color:var(--green-deeper)"></div> Cargando...</div> }
                else
                { <div class="db-canvas-wrap"><canvas id="chartEvolucion"></canvas></div> }
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="db-chart-panel">
                <p class="db-chart-ttl"><i class="bi bi-bar-chart-steps"></i> Top Grupos con más Líneas</p>
                <p class="db-chart-sub">Grupos ordenados por cantidad de líneas asignadas</p>
                @if (cargandoGraficas)
                { <div class="chart-spinner"><div class="spinner-border spinner-border-sm" style="color:var(--green-deeper)"></div> Cargando...</div> }
                else
                { <div class="db-canvas-wrap"><canvas id="chartTopGrupos"></canvas></div> }
            </div>
        </div>
    </div>

    <hr class="db-divider" />

    @* ════ TABLA: TOTAL DE REGISTROS POR TABLA ════ *@
    <div class="db-chart-panel">
        <p class="db-chart-ttl"><i class="bi bi-table"></i> Total de Registros por Tabla</p>
        <p class="db-chart-sub">Conteo actual de registros en cada tabla del sistema</p>
        <div class="table-responsive">
            <table class="table db-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Tabla</th>
                        <th>Descripción</th>
                        <th class="text-center">Registros</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><i class="bi bi-diagram-3-fill me-2" style="color:#2d6a1f"></i><strong>linea_investigacion</strong></td>
                        <td class="text-muted">Líneas de investigación registradas</td>
                        <td class="text-center"><span class="db-num">@tLineas</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-people-fill me-2" style="color:#3d7a2a"></i><strong>grupo_investigacion</strong></td>
                        <td class="text-muted">Grupos de investigación</td>
                        <td class="text-center"><span class="db-num">@tGrupos</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-mortarboard-fill me-2" style="color:#4e8c3a"></i><strong>semillero</strong></td>
                        <td class="text-muted">Semilleros de investigación</td>
                        <td class="text-center"><span class="db-num">@tSemilleros</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-briefcase-fill me-2" style="color:#6fa057"></i><strong>area_aplicacion</strong></td>
                        <td class="text-muted">Áreas de aplicación</td>
                        <td class="text-center"><span class="db-num">@tAreasAp</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-book-fill me-2" style="color:#8dba74"></i><strong>area_conocimiento</strong></td>
                        <td class="text-muted">Áreas de conocimiento</td>
                        <td class="text-center"><span class="db-num">@tAreasCo</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-globe-americas me-2" style="color:#4e8c3a"></i><strong>objetivo_desarrollo_sostenible</strong></td>
                        <td class="text-muted">ODS registrados</td>
                        <td class="text-center"><span class="db-num">@tOds</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-person-check-fill me-2" style="color:#6fa057"></i><strong>participa_grupo</strong></td>
                        <td class="text-muted">Participaciones en grupos</td>
                        <td class="text-center"><span class="db-num">@tPartGrupo</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-person-check me-2" style="color:#8dba74"></i><strong>participa_semillero</strong></td>
                        <td class="text-muted">Participaciones en semilleros</td>
                        <td class="text-center"><span class="db-num">@tPartSemillero</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-link-45deg me-2" style="color:#2d6a1f"></i><strong>grupo_linea</strong></td>
                        <td class="text-muted">Relaciones grupo ↔ línea</td>
                        <td class="text-center"><span class="db-num">@tGrupoLinea</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-link me-2" style="color:#3d7a2a"></i><strong>ac_linea</strong></td>
                        <td class="text-muted">Relaciones área de conocimiento ↔ línea</td>
                        <td class="text-center"><span class="db-num">@tAcLinea</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-link me-2" style="color:#4e8c3a"></i><strong>aa_linea</strong></td>
                        <td class="text-muted">Relaciones área de aplicación ↔ línea</td>
                        <td class="text-center"><span class="db-num">@tAaLinea</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-link me-2" style="color:#6fa057"></i><strong>semillero_linea</strong></td>
                        <td class="text-muted">Relaciones semillero ↔ línea</td>
                        <td class="text-center"><span class="db-num">@tSemilleroLinea</span></td>
                    </tr>
                    <tr>
                        <td><i class="bi bi-link me-2" style="color:#8dba74"></i><strong>ods_linea</strong></td>
                        <td class="text-muted">Relaciones ODS ↔ línea</td>
                        <td class="text-center"><span class="db-num">@tOdsLinea</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    // Cards
    private int    cTotalGrupos=0, cTotalSemilleros=0, cAreasApVinc=0, cAreasCoVinc=0, cOdsVinc=0;
    private bool   cargandoCards = true;
    private string errorCards    = "";

    // Tabla totales
    private int tLineas=0, tAreasAp=0, tAreasCo=0, tOds=0,
                tGrupos=0, tSemilleros=0, tPartGrupo=0,
                tPartSemillero=0, tGrupoLinea=0, tAcLinea=0,
                tAaLinea=0, tSemilleroLinea=0, tOdsLinea=0;

    // Gráficas
    private List<string> g1Labels=new(); private List<int> g1Data=new();
    private List<string> g2Labels=new(); private List<int> g2Data=new();
    private List<string> g3Anios=new();
    private List<int>    g3Grupos=new(); private List<int> g3Semilleros=new();
    private List<string> g4Labels=new(); private List<int> g4Data=new();

    private bool cargandoGraficas = true;
    private bool graficasListas   = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarCards();
        await CargarTotalesTabla();
        await CargarGraficas();
        graficasListas = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (graficasListas)
        {
            graficasListas = false;
            await PintarGraficas();
        }
    }

    private async Task CargarCards()
    {
        try
        {
            var (ok, rows, msg) = await SpService.EjecutarSpAsync("SP_DASHBOARD_CARDS");
            if (ok && rows.Count > 0)
            {
                var r = rows[0];
                cTotalGrupos     = Int(r, "total_grupos");
                cTotalSemilleros = Int(r, "total_semilleros");
                cAreasApVinc     = Int(r, "areas_aplicacion_vinculadas");
                cAreasCoVinc     = Int(r, "areas_conocimiento_vinculadas");
                cOdsVinc         = Int(r, "ods_vinculados");
            }
            else errorCards = string.IsNullOrEmpty(msg) ? "Sin datos del SP." : msg;
        }
        catch { errorCards = "Error al conectar con la API."; }
        finally { cargandoCards = false; }
    }

    private async Task CargarTotalesTabla()
    {
        try
        {
            var (ok, rows, _) = await SpService.EjecutarSpAsync("SP_DASHBOARD_TOTALES_TABLAS");
            if (ok && rows.Count > 0)
            {
                var r = rows[0];
                tLineas         = Int(r, "total_lineas");
                tAreasAp        = Int(r, "total_areas_ap");
                tAreasCo        = Int(r, "total_areas_co");
                tOds            = Int(r, "total_ods");
                tGrupos         = Int(r, "total_grupos");
                tSemilleros     = Int(r, "total_semilleros");
                tPartGrupo      = Int(r, "total_participa_grupo");
                tPartSemillero  = Int(r, "total_participa_semillero");
                tGrupoLinea     = Int(r, "total_grupo_linea");
                tAcLinea        = Int(r, "total_ac_linea");
                tAaLinea        = Int(r, "total_aa_linea");
                tSemilleroLinea = Int(r, "total_semillero_linea");
                tOdsLinea       = Int(r, "total_ods_linea");
            }
        }
        catch { }
    }

    private async Task CargarGraficas()
    {
        try
        {
            var (ok1,r1,_) = await SpService.EjecutarSpAsync("SP_GRAFICA_GRUPOS_CATEGORIA");
            if (ok1 && r1.Count>0) { g1Labels=r1.Select(f=>Str(f,"categoria")).ToList(); g1Data=r1.Select(f=>Int(f,"cantidad")).ToList(); }

            var (ok2,r2,_) = await SpService.EjecutarSpAsync("SP_GRAFICA_AREAS_CONOCIMIENTO");
            if (ok2 && r2.Count>0) { g2Labels=r2.Select(f=>Str(f,"area")).ToList(); g2Data=r2.Select(f=>Int(f,"cantidad")).ToList(); }

            var (ok3,r3,_) = await SpService.EjecutarSpAsync("SP_GRAFICA_EVOLUCION_FUNDACIONES");
            if (ok3 && r3.Count>0) { g3Anios=r3.Select(f=>Str(f,"anio")).ToList(); g3Grupos=r3.Select(f=>Int(f,"cantidad_grupos")).ToList(); g3Semilleros=r3.Select(f=>Int(f,"cantidad_semilleros")).ToList(); }

            var (ok4,r4,_) = await SpService.EjecutarSpAsync("SP_GRAFICA_TOP_GRUPOS_LINEAS");
            if (ok4 && r4.Count>0) { g4Labels=r4.Select(f=>Str(f,"nombre")).ToList(); g4Data=r4.Select(f=>Int(f,"cantidad_lineas")).ToList(); }
        }
        catch { }
        finally { cargandoGraficas = false; }
    }

    private async Task PintarGraficas()
    {
        if (g1Labels.Count>0) await JS.InvokeVoidAsync("dashCharts.renderBarras",  "chartGruposCategoria", g1Labels.ToArray(), g1Data.ToArray());
        if (g2Labels.Count>0) await JS.InvokeVoidAsync("dashCharts.renderPie",     "chartAreasCon",        g2Labels.ToArray(), g2Data.ToArray());
        if (g3Anios.Count>0)  await JS.InvokeVoidAsync("dashCharts.renderLineas",  "chartEvolucion",       g3Anios.ToArray(),  g3Grupos.ToArray(), g3Semilleros.ToArray());
        if (g4Labels.Count>0) await JS.InvokeVoidAsync("dashCharts.renderBarrasH", "chartTopGrupos",       g4Labels.ToArray(), g4Data.ToArray());
    }

    public async ValueTask DisposeAsync()
    {
        foreach (var id in new[]{"chartGruposCategoria","chartAreasCon","chartEvolucion","chartTopGrupos"})
            try { await JS.InvokeVoidAsync("dashCharts.destroy", id); } catch { }
    }

    private int Pct(int v, int max) => max<=0 ? 0 : Math.Min(100,(int)Math.Round((double)v/max*100));

    private int Int(Dictionary<string,object?> d, string k) =>
        d.TryGetValue(k, out var v) && v is not null
            ? v switch { int i=>i, long l=>(int)l, double x=>(int)x,
                         string s when int.TryParse(s,out int p)=>p, _=>0 } : 0;

    private string Str(Dictionary<string,object?> d, string k) =>
        d.TryGetValue(k, out var v) ? v?.ToString() ?? "" : "";
}
