@*
    CrearUsuario.razor - Pagina de registro de nuevos usuarios.

    CONCEPTOS BLAZOR:
    - @layout EmptyLayout         -> Usa layout vacio (sin sidebar/menu) porque
                                     el registro no necesita navegacion lateral
    - @inject AuthService auth    -> Inyecta el servicio de autenticacion (Dependency Injection)
                                     para acceder al metodo Registrar()
    - @inject NavigationManager   -> Para redirigir a /login despues del registro exitoso
    - @rendermode InteractiveServer -> Necesario para que @onclick y @bind funcionen via SignalR
    - @onclick="DoRegister"       -> Al hacer clic en el boton, ejecuta el metodo DoRegister()
    - disabled="@(cargando || registrado)" -> Deshabilita el boton mientras procesa o ya registro,
                                              evitando envios dobles

    AUTENTICACION / AUTORIZACION:
    - La validacion de formato contrasena antes de guardarse:
        * Email no vacio y con "@"
        * Contrasena minimo 6 caracteres
        * Al menos 1 mayuscula (char.IsUpper)
        * Al menos 1 numero (char.IsDigit)
        * Contrasena y confirmacion deben coincidir
    - El hash de la contrasena ocurre en el SERVIDOR (API) con BCrypt,
      nunca se envia ni almacena en texto plano
    - Tras registro exitoso, el usuario es redirigido a /login para autenticarse

    FLUJO:
    1. Usuario llena email, contrasena y confirmacion
    2. Clic en "Registrarse" -> llama DoRegister()
    3. DoRegister() ejecuta validaciones del lado cliente
       - Si alguna falla -> muestra alerta roja y detiene la ejecucion (return)
    4. Si todas pasan -> cargando = true (muestra spinner, deshabilita boton)
    5. Llama auth.Registrar(email, contrasena) que envia los datos a la API REST
    6. cargando = false al recibir respuesta
    7a. Si ok == true  -> registrado = true, muestra alerta verde,
                          espera 2 segundos y redirige a /login
    7b. Si ok == false -> muestra el mensaje de error devuelto por la API
                          (ej: "El correo ya esta registrado")
*@

@page "/crear-usuario"
@layout FrontBlazor_AppiGenericaCsharp.Components.Layout.EmptyLayout
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService auth
@inject NavigationManager nav
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card register-card">
        <div class="login-header">
            <i class="bi bi-person-plus" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
            <h4>Crear Cuenta</h4>
            <p class="small mb-0 opacity-75">Únete a la Gestión de Investigación</p>
        </div>

        <div class="req-text">
            <i class="bi bi-info-circle me-1"></i> 
            Debe incluir 1 mayúscula y 1 número.
        </div>

        <div class="login-body">

            @if (!string.IsNullOrEmpty(error)){
                <div class="alert-custom alert-err mb-3">
                    <i class="bi bi-exclamation-circle"></i>
                    <span>@error</span>
                    <button class="alert-close" @onclick='() => error = ""'>&times;</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(exito)){
                <div class="alert-custom alert-ok mb-3">
                    <i class="bi bi-check-circle"></i>
                    <span>@exito</span>
                </div>
            }

            <div class="mb-3">
                <label class="form-label small fw-bold text-muted">Correo electrónico</label>
                <input type="email" class="login-input" @bind="email"
                       placeholder="usuario@itm.edu.co" disabled="@cargando" />
            </div>

            <div class="form-row mb-3">
                <div class="form-group">
                    <label class="form-label small fw-bold text-muted">Contraseña</label>
                    <input type="password" class="login-input" @bind="contrasena"
                           placeholder="••••••••" disabled="@cargando" />
                </div>
                <div class="form-group">
                    <label class="form-label small fw-bold text-muted">Confirmar</label>
                    <input type="password" class="login-input" @bind="confirmarContrasena"
                           placeholder="••••••••" disabled="@cargando" />
                </div>
            </div>

            <button class="btn-login mt-2" @onclick="DoRegister" disabled="@(cargando || registrado)">
                @if (cargando){
                    <span class="spinner me-2" style="width:16px;height:16px;border-width:2px;display:inline-block;vertical-align:middle;"></span>
                    <span>Procesando...</span>
                }else{
                    <span>Registrarse</span>
                }
            </button>

            <div class="login-footer">
                <span class="small text-muted">¿Ya tienes una cuenta?</span>
                <a href="/login" class="login-link">Inicia sesión aquí</a>
            </div>

        </div>
    </div>
</div>

@code {
    private string email = "";
    private string contrasena = "";
    private string confirmarContrasena = "";
    private string error = "";
    private string exito = "";
    private bool cargando = false;
    private bool registrado = false;

    private async Task DoRegister(){
        error = "";
        exito = "";

        // ── Validaciones ──
        if (string.IsNullOrWhiteSpace(email)){
            error = "El correo es obligatorio."; return;
        }
        if (!email.Contains("@")){
            error = "Ingresá un correo válido."; return;
        }
        if (string.IsNullOrWhiteSpace(contrasena)){
            error = "La contraseña es obligatoria."; return;
        }
        if (contrasena.Length < 6) { 
            error = "Minimo 6 caracteres."; return; 
        }
        if (!contrasena.Any(char.IsUpper)) { 
            error = "Debe incluir al menos una mayuscula."; return; 
        }
        if (!contrasena.Any(char.IsDigit)) { 
            error = "Debe incluir al menos un numero."; return; 
        }
        if (contrasena != confirmarContrasena){
            error = "Las contraseñas no coinciden."; return;
        }

        cargando = true;
        var (ok, mensaje) = await auth.Registrar(email.Trim(), contrasena);
        cargando = false;

        if (ok){
            registrado = true;
            exito = "Cuenta creada. Redirigiendo al login...";
            await Task.Delay(2000);
            nav.NavigateTo("/login");
        }else{
            error = mensaje;
        }
    }
}