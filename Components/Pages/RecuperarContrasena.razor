@*
    RecuperarContrasena.razor - Formulario para recuperar contrasena olvidada.

    COMO FUNCIONA:
    1. El usuario ingresa su email
    2. El AuthService busca el usuario en la BD
    3. Genera contrasena temporal aleatoria (ej: "Ak7xPm2q")
    4. La guarda encriptada con BCrypt en la BD (la anterior se pierde)
    5. Intenta enviarla por correo SMTP (si esta configurado en appsettings.json)
    6. En el proximo login, el sistema FUERZA cambio de contrasena

    NOTA DE SEGURIDAD:
    - Esta pagina usa EmptyLayout (sin sidebar) porque el usuario no esta logueado
    - Es la unica pagina (ademas de /login) accesible sin autenticacion

    SMTP:
    - Si SMTP no esta configurado, muestra la temporal en pantalla (para desarrollo)
    - En produccion, configurar Smtp:User y Smtp:Pass en appsettings.json
*@

@page "/recuperar-contrasena"
@layout FrontBlazor_AppiGenericaCsharp.Components.Layout.EmptyLayout
@inject FrontBlazor_AppiGenericaCsharp.Services.AuthService auth
@inject NavigationManager nav
@inject IConfiguration config
@rendermode InteractiveServer

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-envelope-check" style="font-size: 2.5rem; display: block; margin-bottom: 0.5rem;"></i>
            <h4>Recuperar Acceso</h4>
            <p class="small mb-0 opacity-75">Te ayudaremos a volver al sistema</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert-custom @(tipoMensaje == "success" ? "alert-ok" : "alert-err") mb-3">
                    <i class="bi @(tipoMensaje == "success" ? "bi-check-circle" : "bi-exclamation-triangle")"></i>
                    <span>@mensaje</span>
                    <button class="alert-close" @onclick='() => mensaje = ""'>&times;</button>
                </div>
            }

            <div class="info-text-box">
                <i class="bi bi-info-circle me-1"></i>
                Ingresa tu correo. Te enviaremos una <strong>contraseña temporal</strong> para que puedas ingresar.
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold text-muted">Correo electrónico</label>
                <input type="email" class="login-input" @bind="email" placeholder="usuario@itm.edu.co" />
            </div>

            <button class="btn-recover" @onclick="Recuperar" disabled="@cargando">
                @if (cargando)
                {
                    <span class="spinner me-2" style="width:16px; height:16px; border-width:2px; display:inline-block; vertical-align:middle;"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar instrucciones</span>
                }
            </button>

            <div class="login-footer">
                <a href="/login" class="login-link">
                    <i class="bi bi-arrow-left"></i> Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    string email = "", mensaje = "", tipoMensaje = "info";
    bool cargando;

    async Task Recuperar()
    {
        mensaje = "";
        if (string.IsNullOrWhiteSpace(email))
        {
            tipoMensaje = "danger";
            mensaje = "Ingrese su correo electronico.";
            return;
        }

        cargando = true;
        // Llama al AuthService que:
        // 1. Verifica que el email exista
        // 2. Genera temporal aleatoria
        // 3. La guarda con BCrypt
        // 4. Intenta enviar por SMTP
        var (ok, msg) = await auth.RecuperarContrasena(email, config);
        cargando = false;

        tipoMensaje = ok ? "success" : "danger";
        mensaje = msg;
    }
}
